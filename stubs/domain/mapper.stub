use App\Domains\{{ domain }}\Infrastructure\Eloquent\Models\{{ entity }}Model;
use DateTimeImmutable;

final class {{ entity }}Mapper
{
    public function toEntity({{ entity }}Model $model): {{ entity }}
    {
        return {{ entity }}::restore(
            id: $model->uuid,
{{ mapperToEntity }}
            createdAt: DateTimeImmutable::createFromInterface($model->created_at),
        );
    }

    /**
     * @return array<string, mixed>
     */
    public function toAttributes({{ entity }} ${{ variable }}{{ mapperToAttributesParams }}): array
