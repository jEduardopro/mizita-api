<?php

declare(strict_types=1);

namespace App\Domains\{{ domain }}\Exceptions;

use App\Shared\Contracts\DomainFailure;
use App\Shared\ValueObjects\DomainFailureKind;
use RuntimeException;

final class {{ entity }}NotFound extends RuntimeException implements DomainFailure
{
    public static function withId(string $id): self
    {
        return new self("{{ entity }} [{$id}] was not found.");
    }

    public function errorCode(): string
    {
        return '{{ entitySnake }}_not_found';
    }

    public function kind(): DomainFailureKind
    {
        return DomainFailureKind::NotFound;
    }
}
