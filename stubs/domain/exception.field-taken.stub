<?php

declare(strict_types=1);

namespace App\Domains\{{ domain }}\Exceptions;

use App\Shared\Contracts\DomainFailure;
use App\Shared\ValueObjects\DomainFailureKind;
use DomainException;

final class {{ entity }}{{ uniqueField }}AlreadyTaken extends DomainException implements DomainFailure
{
    public static function for(string $value): self
    {
        return new self("A {{ variable }} with {{ uniqueFieldLabel }} [{$value}] already exists.");
    }

